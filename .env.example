PORT=4321
VITE_API_URL=http://localhost:4321

DATABASE_URL=file:./data/lvl-state.sqlite

# Bring your own OpenRouter key. The app should also support configuring this
# from the site as the hosted/self-serve flow matures.
OPENROUTER_API_KEY=

OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=lvl Local

# Optional safety limits for CLI tournament runs.
TOURNAMENT_MAX_COST_USD_PER_RUN=20
TOURNAMENT_MEMORY_MODE=fresh
