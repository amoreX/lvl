PORT=4321
VITE_API_URL=http://localhost:4321

DATABASE_URL=file:./data/lvl-state.sqlite

# Bring your own OpenRouter key. You can also save this from the setup
# card in the local web app; the saved value lives in ignored data/.
OPENROUTER_API_KEY=

OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=lvl Local

# Stockfish is required for objective chess scoring. If `stockfish` is not on
# PATH, point this at the UCI binary, for example /opt/homebrew/bin/stockfish.
STOCKFISH_PATH=stockfish
STOCKFISH_DEPTH=8
STOCKFISH_TIMEOUT_MS=2500

# Optional safety limits for CLI tournament runs.
TOURNAMENT_MAX_COST_USD_PER_RUN=20
TOURNAMENT_MEMORY_MODE=fresh
