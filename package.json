{
  "name": "lvl-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c amber,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "parser:test": "tsx scripts/test-browser-parser.ts",
    "chess:verify": "tsx scripts/run-chess-verify.ts",
    "chess:match": "tsx scripts/run-chess-match.ts",
    "suite:smoke": "tsx scripts/run-multiseed-suite.ts",
    "benchmark": "tsx scripts/run-benchmark.ts",
    "benchmark:premium": "tsx scripts/run-premium-benchmark.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "chess.js": "^1.4.0",
    "concurrently": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "playwright": "^1.60.0",
    "react": "latest",
    "react-dom": "latest",
    "uuid": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
