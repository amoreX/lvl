{
  "name": "lvl-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c amber,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/server/index.ts",
    "dev:web": "tsx scripts/wait-for-api.ts && vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/server/index.ts",
    "parser:test": "tsx scripts/test-browser-parser.ts",
    "stockfish:test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/test-stockfish.ts",
    "chess:match": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/run-chess-match.ts",
    "tournament:run": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/run-tournament.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "chess.js": "^1.4.0",
    "concurrently": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "playwright": "^1.60.0",
    "react": "latest",
    "react-dom": "latest",
    "uuid": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
